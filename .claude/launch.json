{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "agrispectra-web",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd app && flutter run -d web-server --web-port 8090 --web-header=Cross-Origin-Opener-Policy=same-origin --web-header=Cross-Origin-Embedder-Policy=require-corp"
      ],
      "port": 8090
    }
  ]
}
